
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow any authenticated user to create a new clinic, and write to its subcollections.
    match /clinics/{clinicId} {
      // Allow clinic creation by any authenticated user.
      allow create: if request.auth != null;
      // Allow admins to update clinic details (like the name).
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Allow clinic members to read clinic details.
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;

      // Rules for the patients subcollection
      match /patients/{patientId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
       
      // Rule for procedures
      match /procedures/{procedureId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Rule for appointments
      match /appointments/{appointmentId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Rule for doctors
      match /doctors/{doctorId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Rule for drugs
      match /drugs/{drugId} {
         allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Rule for medical emergencies
      match /medicalEmergencies/{emergencyId} {
         allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Rule for prescriptions
      match /prescriptions/{prescriptionId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Rule for transactions
      match /transactions/{transactionId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Rule for invoices
      match /invoices/{invoiceId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Clinic-scoped rule for staff and attendance
      match /staff/{staffId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
        
        match /attendance/{date} {
           allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
        }
      }

      // Explicit rule for inventoryCategories and its items subcollection
      match /inventoryCategories/{catId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
        
        match /items/{itemId} {
           allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
        }
      }

      // Rule for operatories
      match /operatories/{operatoryId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Rule for departments
      match /departments/{departmentId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }

      // Rules for Academics
      match /students/{studentId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
        
        match /attendance/{date} {
           allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
        }
      }
      match /studentCaseHistories/{historyId} {
        allow read, list, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
      
      // Allow clinic members to read/write their own data within their clinic's subcollections
      // This is a broad rule and should be placed last.
      match /{document=**} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
      }
    }

    // Allow user to manage their own user document
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for user-specific data (existing)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
