rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile files — owner only, no email-verified requirement
    // (users may upload a profile photo before verifying their email)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Clinic files — must be authenticated AND have a verified email
    match /clinics/{clinicId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email_verified == true;
    }
  }
}
