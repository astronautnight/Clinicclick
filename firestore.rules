rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isClinicAdmin(clinicId) {
      return exists(
        /databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)
      ) &&
      get(
        /databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)
      ).data.role == 'admin';
    }

    function isClinicMember(clinicId) {
      return exists(
        /databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)
      );
    }

    /* ================= USERS ================= */
    match /users/{userId} {
      allow read: if signedIn();

      // User can update self OR clinic admin can update users in their clinic (adding or removing)
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.clinicId != null && isClinicAdmin(resource.data.clinicId)) ||
        (request.resource.data.clinicId != null && isClinicAdmin(request.resource.data.clinicId))
      );

      allow create: if signedIn();
    }

    /* ================= NOTIFICATIONS ================= */
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    /* ================= SURVEY RESPONSES ================= */
    match /survey_responses/{responseId} {
      allow read, create, update: if signedIn();
    }

    /* ================= CLINICS ================= */
    match /clinics/{clinicId} {

      // Anyone signed in can read clinic BASIC info
      // (needed to join with invite code)
      allow read: if signedIn();

      // Anyone signed in can create a clinic
      allow create: if signedIn();

      // Only admins can update/delete clinic
      allow update, delete: if signedIn() && isClinicAdmin(clinicId);
    }

    /* ================= MEMBERS ================= */
    match /clinics/{clinicId}/members/{uid} {
      // Anyone in clinic can read members
      allow read: if signedIn() && isClinicMember(clinicId);

      // ONLY clinic admins can add a member, EXCEPT the creator of the clinic can create their own member doc initially.
      allow create: if signedIn() && (
        isClinicAdmin(clinicId) ||
        (request.auth.uid == uid && get(/databases/$(database)/documents/clinics/$(clinicId)).data.createdBy == request.auth.uid)
      );

      // Admin controls members AFTER creation, OR member can remove themselves (leave)
      allow update: if signedIn() && isClinicAdmin(clinicId);
      allow delete: if signedIn() && (isClinicAdmin(clinicId) || request.auth.uid == uid);
    }

    /* ================= PATIENTS ================= */
    match /clinics/{clinicId}/patients/{patientId} {
      allow read, create, update: if signedIn() && isClinicMember(clinicId);
      allow delete: if signedIn() && isClinicAdmin(clinicId);
    }

    /* ================= DRUGS ================= */
    match /clinics/{clinicId}/drugs/{drugId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= MEDICAL EMERGENCIES ================= */
    match /clinics/{clinicId}/medicalEmergencies/{emergencyId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= PRESCRIPTIONS ================= */
    match /clinics/{clinicId}/prescriptions/{prescriptionId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= INVENTORY ================= */
    match /clinics/{clinicId}/inventoryCategories/{categoryId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    match /clinics/{clinicId}/inventoryCategories/{categoryId}/items/{itemId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= APPOINTMENTS ================= */
    match /clinics/{clinicId}/appointments/{appointmentId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= PENDING REQUESTS ================= */
    match /clinics/{clinicId}/pendingRequests/{uid} {
      allow create: if signedIn();
      allow read, delete: if signedIn() && isClinicAdmin(clinicId);
    }
    
    /* ================= PROCEDURES ================= */
    match /clinics/{clinicId}/procedures/{procedureId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= DOCTORS ================= */
    match /clinics/{clinicId}/doctors/{doctorId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= STAFF ================= */
    match /clinics/{clinicId}/staff/{staffId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= STAFF ATTENDANCE ================= */
    match /clinics/{clinicId}/staff/{staffId}/attendance/{dateId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }
     
    /* ================= TRANSACTIONS ================= */
    match /clinics/{clinicId}/transactions/{transactionId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= STUDENTS ================= */
    match /clinics/{clinicId}/students/{studentId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= STUDENT ATTENDANCE ================= */
    match /clinics/{clinicId}/students/{studentId}/attendance/{dateId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= STUDENT FINANCES ================= */
    match /clinics/{clinicId}/students/{studentId}/finances/{financeId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= DEPARTMENTS ================= */
    match /clinics/{clinicId}/departments/{departmentId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= STUDENT CASE HISTORIES ================= */
    match /clinics/{clinicId}/studentCaseHistories/{caseId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= OPERATORIES ================= */
    match /clinics/{clinicId}/operatories/{operatoryId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= INVOICES ================= */
    match /clinics/{clinicId}/invoices/{invoiceId} {
      allow read, create, update, delete: if signedIn() && isClinicMember(clinicId);
    }

    /* ================= CLINIC DATA (catch-all) ================= */
    // Recursive wildcard {document=**} matches any nested documents and subcollections,
    // and correctly permits collection list/query operations (onSnapshot/getDocs).
    match /clinics/{clinicId}/{document=**} {
      allow read, create: if signedIn() && isClinicMember(clinicId);
      allow update, delete: if signedIn() && isClinicAdmin(clinicId);
    }

    /* ===============================================================
       PERSONAL DATA (no clinic required)
       Users own their personal consultation and academic data.
       No other user — not even clinic members — can access it.
    =============================================================== */

    /* Personal Consultation: patients, appointments, transactions */
    match /users/{userId}/personalConsultation/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    /* Personal Academics: departments, studentCaseHistories, attendance, finances */
    match /users/{userId}/personalAcademics/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
