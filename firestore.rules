rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Core Auth Helpers
    // ---------------------------------------------------------------

    // Returns true if any Firebase user is signed-in (token present).
    function signedIn() {
      return request.auth != null;
    }

    // Returns true when the signed-in user has verified their email address.
    // Reads from the JWT directly — cannot be spoofed via client data.
    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    // Convenience: authenticated AND email-verified.
    // Apply to every clinic-sensitive operation so unverified accounts
    // cannot read or mutate protected health / clinic data.
    function verifiedAndSignedIn() {
      return signedIn() && emailVerified();
    }

    // ---------------------------------------------------------------
    // Role / Membership Helpers
    // ---------------------------------------------------------------

    function isClinicAdmin(clinicId) {
      return (
        (exists(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/clinics/$(clinicId)) &&
         get(/databases/$(database)/documents/clinics/$(clinicId)).data.createdBy == request.auth.uid) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'] ||
          !('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)))
      );
    }

    function isClinicMember(clinicId) {
      return exists(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)) ||
             (exists(/databases/$(database)/documents/clinics/$(clinicId)) &&
              get(/databases/$(database)/documents/clinics/$(clinicId)).data.createdBy == request.auth.uid) ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId);
    }

    /* ================= USERS =================
       Kept on plain signedIn() so that newly-registered (unverified)
       users can complete their profile / onboarding flow.
    */
    match /users/{userId} {
      allow read: if signedIn();

      // User can update self OR clinic admin can update users in their clinic
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.clinicId != null && isClinicAdmin(resource.data.clinicId)) ||
        (request.resource.data.clinicId != null && isClinicAdmin(request.resource.data.clinicId))
      );

      allow create: if signedIn();
    }

    /* ================= NOTIFICATIONS =================
       Also kept on plain signedIn() — notification writes may happen
       during the onboarding / registration phase.
    */
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    /* ================= SURVEY RESPONSES =================
       Kept on plain signedIn() — surveys can be filled in before
       email verification completes.
    */
    match /survey_responses/{responseId} {
      allow create, read: if signedIn();
    }

    /* ================= CLINICS =================
       Reading clinic info (needed to join via invite code) and creating
       a new clinic now require email verification to prevent spam /
       abuse by throwaway unverified accounts.
    */
    match /clinics/{clinicId} {
      // Email-verified users can read clinic basic info (e.g., to look up invite codes)
      allow read: if verifiedAndSignedIn();

      // Only email-verified users may create a clinic
      allow create: if verifiedAndSignedIn();

      // Clinic members / admins can update; only admins can delete
      allow update: if verifiedAndSignedIn() && (isClinicAdmin(clinicId) || isClinicMember(clinicId));
      allow delete: if verifiedAndSignedIn() && isClinicAdmin(clinicId);
    }

    /* ================= MEMBERS ================= */
    match /clinics/{clinicId}/members/{uid} {
      allow read: if verifiedAndSignedIn() && isClinicMember(clinicId);

      allow create: if verifiedAndSignedIn() && (
        isClinicAdmin(clinicId) ||
        (request.auth.uid == uid && get(/databases/$(database)/documents/clinics/$(clinicId)).data.createdBy == request.auth.uid)
      );

      allow update: if verifiedAndSignedIn() && isClinicAdmin(clinicId);
      allow delete: if verifiedAndSignedIn() && (isClinicAdmin(clinicId) || request.auth.uid == uid);
    }

    /* ================= PATIENTS ================= */
    match /clinics/{clinicId}/patients/{patientId} {
      allow read, create, update: if verifiedAndSignedIn() && isClinicMember(clinicId);
      allow delete: if verifiedAndSignedIn() && (isClinicAdmin(clinicId) || isClinicMember(clinicId));
    }

    /* ================= DRUGS ================= */
    match /clinics/{clinicId}/drugs/{drugId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= MEDICAL EMERGENCIES ================= */
    match /clinics/{clinicId}/medicalEmergencies/{emergencyId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= PRESCRIPTIONS ================= */
    match /clinics/{clinicId}/prescriptions/{prescriptionId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= INVENTORY ================= */
    match /clinics/{clinicId}/inventoryCategories/{categoryId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    match /clinics/{clinicId}/inventoryCategories/{categoryId}/items/{itemId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= APPOINTMENTS ================= */
    match /clinics/{clinicId}/appointments/{appointmentId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= PENDING REQUESTS =================
       'create' intentionally stays on plain signedIn() so that
       users who haven't yet verified their email can still submit a
       join request to a clinic.  Reading and deleting requests require
       verification (admin-side operation).
    */
    match /clinics/{clinicId}/pendingRequests/{uid} {
      allow create: if signedIn();
      allow read, delete: if verifiedAndSignedIn() && (isClinicAdmin(clinicId) || request.auth.uid == uid);
    }

    /* ================= PROCEDURES ================= */
    match /clinics/{clinicId}/procedures/{procedureId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= DOCTORS ================= */
    match /clinics/{clinicId}/doctors/{doctorId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= STAFF ================= */
    match /clinics/{clinicId}/staff/{staffId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= STAFF ATTENDANCE ================= */
    match /clinics/{clinicId}/staff/{staffId}/attendance/{dateId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= TRANSACTIONS ================= */
    match /clinics/{clinicId}/transactions/{transactionId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= STUDENTS ================= */
    match /clinics/{clinicId}/students/{studentId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= STUDENT ATTENDANCE ================= */
    match /clinics/{clinicId}/students/{studentId}/attendance/{dateId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= STUDENT FINANCES ================= */
    match /clinics/{clinicId}/students/{studentId}/finances/{financeId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= DEPARTMENTS ================= */
    match /clinics/{clinicId}/departments/{departmentId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= STUDENT CASE HISTORIES ================= */
    match /clinics/{clinicId}/studentCaseHistories/{caseId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= OPERATORIES ================= */
    match /clinics/{clinicId}/operatories/{operatoryId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= INVOICES ================= */
    match /clinics/{clinicId}/invoices/{invoiceId} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ================= CLINIC DATA (catch-all) =================
       Recursive wildcard matches any nested documents / subcollections
       not covered by the explicit rules above, and permits collection
       list / query operations (onSnapshot / getDocs).
       Email verification is required for all catch-all clinic data.
    */
    match /clinics/{clinicId}/{document=**} {
      allow read, create, update, delete: if verifiedAndSignedIn() && isClinicMember(clinicId);
    }

    /* ===============================================================
       PERSONAL DATA (no clinic required)
       Users own their personal consultation and academic data.
       No other user — not even clinic members — can access it.
       Email verification is required so that abandoned / unverified
       accounts cannot accumulate sensitive personal records.
    =============================================================== */

    /* Personal Consultation: patients, appointments, transactions */
    match /users/{userId}/personalConsultation/{document=**} {
      allow read, write: if verifiedAndSignedIn() && request.auth.uid == userId;
    }

    /* Personal Academics: departments, studentCaseHistories, attendance, finances */
    match /users/{userId}/personalAcademics/{document=**} {
      allow read, write: if verifiedAndSignedIn() && request.auth.uid == userId;
    }
  }
}
